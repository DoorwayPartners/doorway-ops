{
  "name": "doorway-ops",
  "version": "1.0.0",
  "private": true,
  "description": "Doorway Partners Ops Command Center (ops.doorwaypartners.com) — static site + read-only Apps Script API",
  "scripts": {
    "build": "node scripts/build.mjs",
